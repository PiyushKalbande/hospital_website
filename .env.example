# Copy this file to .env and replace the example passwords before starting Docker.
DB_NAME=chinche_hospital
DB_USER=chinche
DB_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password
DB_PORT=3306
APP_PORT=8080
# Keep localhost for local use. For EC2, set to 0.0.0.0 only behind a
# configured firewall/security group or reverse proxy.
APP_BIND_ADDRESS=127.0.0.1

ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=change-this-admin-password
RECEPTION_PASSWORD=change-this-reception-password
SEED_DEMO_DATA=false

# Local test default is Mailpit. For real delivery, use your provider's SMTP
# host/port and an app-specific password; never use or commit your account password.
# Gmail example: smtp.gmail.com:587, auth=true, STARTTLS=true, and a Google App Password.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=dadakalbande111@gmail.com
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_USER=
MAIL_PASSWORD=

# Optional automatic emergency WhatsApp notice. Requires a Meta WhatsApp
# Business Cloud API account and an approved template with four body variables.
WHATSAPP_ENABLED=false
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=doctor_emergency_reschedule
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Local AI is opt-in. Start Ollama with `docker compose --profile ai up -d ollama`
# and pull the model before setting AI_OLLAMA_ENABLED=true.
AI_ASSISTANT_ENABLED=true
AI_ALLOW_UNVERIFIED_KNOWLEDGE=false
AI_OLLAMA_ENABLED=false
AI_OLLAMA_MODEL=qwen2.5:1.5b
AI_OLLAMA_TIMEOUT_SECONDS=120
AI_OLLAMA_CONTEXT_LENGTH=4096
AI_OLLAMA_MAX_TOKENS=192
